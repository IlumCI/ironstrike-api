<Project Sdk="Microsoft.NET.Sdk">
  <!-- Turns IronstrikeApi.dll + its XML doc file into the reStructuredText API reference.
       Reads the DLL with MetadataLoadContext, so nothing in it runs and no game files are needed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="8.0.1" />
  </ItemGroup>
</Project>
