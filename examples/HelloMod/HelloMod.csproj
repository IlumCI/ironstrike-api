<Project Sdk="Microsoft.NET.Sdk">

  <!-- A minimal mod built on the IRONSTRIKE Mod API. Copy this folder to start your own. -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>HelloMod</AssemblyName>
    <Version>1.0.0</Version>
    <LangVersion>latest</LangVersion>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.788" />
  </ItemGroup>

  <!-- The game's interop assemblies (refs/ in the API repo, or your game's BepInEx/interop). -->
  <PropertyGroup Condition="'$(InteropDir)' == ''">
    <InteropDir>$(MSBuildThisFileDirectory)../../refs</InteropDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(InteropDir)/GameAssembly.dll" Private="false" />
    <Reference Include="$(InteropDir)/Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(InteropDir)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(InteropDir)/Fusion.Runtime.dll" Private="false" />
  </ItemGroup>

  <!-- The API itself. Inside this repo, the project; in your own repo, IronstrikeApi.dll from a
       release: <Reference Include="path/to/IronstrikeApi.dll" Private="false" /> -->
  <ItemGroup>
    <ProjectReference Include="../../IronstrikeApi/IronstrikeApi.csproj" Private="false" />
  </ItemGroup>

</Project>
