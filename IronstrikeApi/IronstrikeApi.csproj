<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>IronstrikeApi</AssemblyName>
    <RootNamespace>IronstrikeApi</RootNamespace>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Interop assemblies are reference-only; never copy them to output. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- The /// comments are the API reference: docs/tools/gen_reference.py turns this XML file
         into the reference pages, and fails on any public member without a summary. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS0649;CS0169</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="IronstrikeApi.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.788" />
  </ItemGroup>

  <!-- Reference assemblies. refs/ is committed so CI and a clean clone can build with no
       game files present. Override with -p:InteropDir=<path to BepInEx/interop> to build
       against the set the game actually generated at runtime. -->
  <!-- The icon library (drawn by art/icons/make_icons.py), shipped inside the DLL. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets/Icons/*.png" LogicalName="IronstrikeApi.Icons.%(Filename).png" />
  </ItemGroup>

  <PropertyGroup Condition="'$(InteropDir)' == ''">
    <InteropDir>$(MSBuildThisFileDirectory)../refs</InteropDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(InteropDir)/GameAssembly.dll" Private="false" />
    <Reference Include="$(InteropDir)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(InteropDir)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(InteropDir)/UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="$(InteropDir)/Unity.InputSystem.dll" Private="false" />
    <Reference Include="$(InteropDir)/Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="$(InteropDir)/UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="$(InteropDir)/UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(InteropDir)/UnityEngine.ScreenCaptureModule.dll" Private="false" />
    <Reference Include="$(InteropDir)/UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="$(InteropDir)/Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(InteropDir)/Fusion.Runtime.dll" Private="false" />
    <Reference Include="$(InteropDir)/Fusion.Common.dll" Private="false" />
    <Reference Include="$(InteropDir)/Fusion.Realtime.dll" Private="false" />
    <Reference Include="$(InteropDir)/Fusion.Sockets.dll" Private="false" />
  </ItemGroup>

  <Target Name="CheckInterop" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(InteropDir)/GameAssembly.dll')"
           Text="Interop assemblies not found at '$(InteropDir)'. Pass -p:InteropDir=&lt;path to BepInEx/interop&gt;." />
  </Target>

</Project>
